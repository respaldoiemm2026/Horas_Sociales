# Cadena de conexión a PostgreSQL (Neon u otro)
DATABASE_URL="postgresql://usuario:password@host-neon/neondb?sslmode=require"
PORT=3000

# Autenticación (usa un valor largo y aleatorio en producción)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="1h"

# Orígenes permitidos por CORS, separados por coma y sin "/" al final
FRONTEND_ORIGINS="http://localhost:5500,http://127.0.0.1:5500,https://TU-FRONT.vercel.app"

NODE_ENV="development"
